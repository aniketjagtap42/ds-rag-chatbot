# .gitignore
# ─────────────────────────────────────────────────────
# Files and folders Git should never track.
# ─────────────────────────────────────────────────────

# ── Environment & Secrets ────────────────────────────
# NEVER commit API keys or secrets
.env
.env.local
.env.production
.env.*

# ── Python Cache ─────────────────────────────────────
# Auto-generated bytecode — different on every machine
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ── Virtual Environment ───────────────────────────────
# Everyone creates their own locally
venv/
env/
.venv/

# ── Generated Data ────────────────────────────────────
# Vector database — regenerated by build_index.py
chroma_db/

# Uploaded files — user data, not source code
uploads/

# ── Logs ─────────────────────────────────────────────
# Runtime data — not source code
logs/
*.log

# ── IDE & Editor ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Testing & Coverage ───────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Build Artifacts ──────────────────────────────────
dist/
build/
*.egg-info/